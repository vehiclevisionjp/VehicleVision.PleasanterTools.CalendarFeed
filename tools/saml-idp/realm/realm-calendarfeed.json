        "saml.force.post.binding": "true",
        "saml_name_id_format": "email",
        "saml_force_name_id_format": "true",
        "saml_single_logout_service_url_redirect": "https://localhost:8443/admin/api/saml/slo",
        "saml_single_logout_service_url_post": "https://localhost:8443/admin/api/saml/slo"
      }
    }
  ],
  "components": {
