<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <!-- メールの送信（Questionnaire の Mail と同じ構成・同じ版）。MIT。
         **認証付きリレーの 587 番は Azure でブロックされない**ので、これ 1 本で
         SendGrid・Amazon SES・Azure Communication Services・Microsoft 365 に届く
         （https://learn.microsoft.com/troubleshoot/azure/virtual-network/troubleshoot-outbound-smtp-connectivity
          2026-09-13 参照）。**送信先ごとの純正 SDK は、マネージド ID で秘密を保管しない経路のためだけに足す** -->
    <PackageReference Include="MailKit" Version="4.18.1" />
    <!-- 推移的依存（MimeKit 経由）の脆弱性 GHSA-2fmv-rv2c-59x7 / GHSA-846f-f764-76mx の修正版へ固定する -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
    <PackageReference Include="AWSSDK.SimpleEmailV2" Version="4.0.106.4" />
    <PackageReference Include="Azure.Communication.Email" Version="1.1.0" />
    <PackageReference Include="Azure.Identity" Version="1.21.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.13" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup>
    <!-- 失敗の切り分けを試験から直に見る（再送する価値があるかの判定を機械で押さえる） -->
    <InternalsVisibleTo Include="VehicleVision.PleasanterTools.CalendarFeed.Mail.Tests" />
  </ItemGroup>

</Project>
