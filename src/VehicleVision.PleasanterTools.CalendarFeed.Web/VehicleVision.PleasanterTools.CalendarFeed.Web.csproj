<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <!--
      暫定: Core.Data 0.1.0 の推移依存で、IBM Db2・Firebird のドライバ（独自許諾・IDPL 1.0）が配布物へ入る。
      本アプリは使わないので、アセットを全て除外して publish の出力から外す。バージョンは推移依存の解決版に合わせる。
      Core 側が依存を絞った版（vehiclevisionjp/VehicleVision.PleasanterTools.Core#151）を取り込んだら、この 2 行を外す。
    -->
    <PackageReference Include="Net.IBM.Data.Db2" Version="9.0.0.300" ExcludeAssets="all" />
    <PackageReference Include="FirebirdSql.Data.FirebirdClient" Version="10.3.3" ExcludeAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <!-- 管理画面の SAML 2.0 ログイン（Questionnaire と同じ依存・同じ版）。BSD-3-Clause -->
    <PackageReference Include="ITfoxtec.Identity.Saml2" Version="4.21.0" />
    <PackageReference Include="ITfoxtec.Identity.Saml2.MvcCore" Version="4.21.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- 実値を置く *.local.json は配布物へ入れない -->
    <Content Remove="App_Data/Parameters/*.local.json" />
    <None Remove="App_Data/Parameters/*.local.json" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\VehicleVision.PleasanterTools.CalendarFeed.Core\VehicleVision.PleasanterTools.CalendarFeed.Core.csproj" />
    <ProjectReference Include="..\VehicleVision.PleasanterTools.CalendarFeed.Data\VehicleVision.PleasanterTools.CalendarFeed.Data.csproj" />
    <PackageReference Include="VehicleVision.PleasanterTools.Core.Mail" Version="0.1.0" />
    <!-- Pleasanter のログインの本人確認（PleasanterSessionVerifier）。AtomFeed・Questionnaire と共通の部品 -->
    <PackageReference Include="VehicleVision.PleasanterTools.Core.Web" Version="0.1.0" />
    <ProjectReference Include="..\VehicleVision.PleasanterTools.CalendarFeed.Pleasanter\VehicleVision.PleasanterTools.CalendarFeed.Pleasanter.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- DB の基盤は Core.Data（NuGet）へ集約した。名前空間を暗黙に使えるようにする -->
    <Using Include="VehicleVision.PleasanterTools.Core.Data" />
  </ItemGroup>

</Project>
