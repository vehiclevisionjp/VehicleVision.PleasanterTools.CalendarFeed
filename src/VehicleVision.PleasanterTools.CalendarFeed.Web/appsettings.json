{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.AspNetCore.Hosting.Diagnostics": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "CalendarFeed": "Data Source=App_Data/calendarfeed.db"
  },
  "Feed": {
    "CacheSeconds": 300,
    "MaxEvents": 5000,
    "PageSize": 1000
  }
}
