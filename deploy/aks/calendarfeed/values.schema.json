{
  "$schema": "http://json-schema.org/schema#",
  "type": "object",
  "required": [
    "replicaCount",
    "image",
    "existingSecret",
    "config",
    "resources"
  ],
  "properties": {
    "replicaCount": {
      "type": "integer",
      "minimum": 2
    },
    "image": {
      "type": "object",
      "required": [
        "repository",
        "tag"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "type": "string",
          "minLength": 1,
          "not": {
            "const": "latest"
          },
          "pattern": "^[A-Za-z0-9_][A-Za-z0-9_.-]{0,127}$"
        },
        "pullPolicy": {
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        }
      }
    },
    "existingSecret": {
      "type": "string",
      "minLength": 1
    },
    "config": {
      "type": "object",
      "required": [
        "dbProvider",
        "pleasanterUrl",
        "timezone",
        "forwardedNetworks"
      ],
      "properties": {
        "dbProvider": {
          "enum": [
            "SqlServer",
            "PostgreSql",
            "MySql"
          ]
        },
        "pleasanterUrl": {
          "type": "string",
          "minLength": 1
        },
        "timezone": {
          "type": "string",
          "minLength": 1
        },
        "forwardedNetworks": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[0-9A-Fa-f:.]+/[0-9]{1,3}$"
          }
        },
        "pleasanterSso": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": [
                "boolean",
                "null"
              ]
            },
            "internalBaseUrl": {
              "type": [
                "string",
                "null"
              ]
            },
            "loginUrl": {
              "type": [
                "string",
                "null"
              ]
            },
            "logoutUrl": {
              "type": [
                "string",
                "null"
              ]
            },
            "cookieNames": {
              "type": [
                "string",
                "null"
              ]
            },
            "unknownUser": {
              "enum": [
                "Reject",
                "Register",
                "",
                null
              ]
            },
            "registerRole": {
              "type": [
                "string",
                "null"
              ]
            },
            "revalidateMinutes": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 1,
              "maximum": 60
            },
            "timeoutSeconds": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 1,
              "maximum": 30
            },
            "buttonLabel": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        }
      }
    },
    "ingress": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "host": {
          "type": "string"
        },
        "path": {
          "type": "string",
          "pattern": "^(|/.*)$"
        },
        "pathType": {
          "enum": [
            "Prefix",
            "Exact",
            "ImplementationSpecific"
          ]
        },
        "tlsSecretName": {
          "type": "string"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "enabled": {
                "const": true
              }
            }
          },
          "then": {
            "properties": {
              "host": {
                "minLength": 1
              },
              "tlsSecretName": {
                "minLength": 1
              }
            },
            "required": [
              "host",
              "tlsSecretName"
            ]
          }
        }
      ]
    },
    "migration": {
      "type": "object",
      "properties": {
        "autoMigrateOnStartup": {
          "type": [
            "boolean",
            "null"
          ]
        }
      }
    },
    "autoscaling": {
      "type": "object",
      "required": [
        "enabled",
        "minReplicas",
        "maxReplicas"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "minReplicas": {
          "type": "integer",
          "minimum": 2
        },
        "maxReplicas": {
          "type": "integer",
          "minimum": 2
        }
      }
    },
    "resources": {
      "type": "object",
      "required": [
        "requests",
        "limits"
      ],
      "properties": {
        "requests": {
          "type": "object",
          "required": [
            "cpu",
            "memory"
          ]
        },
        "limits": {
          "type": "object",
          "required": [
            "cpu",
            "memory"
          ]
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "ingress": {
            "properties": {
              "enabled": {
                "const": true
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "config": {
            "properties": {
              "forwardedNetworks": {
                "minItems": 1
              }
            }
          }
        }
      }
    }
  ]
}
