<Project>
  <!--
    ランタイム・言語は Pleasanter 本体と Questionnaire に揃える（net10.0 / SDK 10.0.100）。
    Pleasanter 本体（AGPL v3）のコードはコピー・流用・リンク・プロジェクト参照しない。
    本アプリは標準 Web API を叩く別アプリであり、依存 OSS は寛容ライセンスに限定する（NOTICE）。
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- .editorconfig の IDE 規則（{} の省略禁止など）を、ビルドで強制する -->
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
  </PropertyGroup>

  <!-- バージョンの単一情報源。各 .csproj へ個別に書かないこと。1.0.0 未満は互換を保証しない -->
  <PropertyGroup>
    <VersionPrefix>0.1.1</VersionPrefix>
    <Company>PMC Co., Ltd. IT Solution Div.</Company>
    <Authors>PMC Co., Ltd. IT Solution Div.</Authors>
    <Product>VehicleVision.PleasanterTools.CalendarFeed</Product>
    <Copyright>Copyright (C) PMC Co., Ltd. IT Solution Div.</Copyright>
    <!-- デュアルライセンス（AGPL-3.0-or-later OR 商用）。LICENSING.md を参照。
         NuGet の PackageLicenseExpression は LicenseRef-* を含む式を受け付けないため
         ライセンスファイルを参照する -->
    <PackageLicenseFile>LICENSING.md</PackageLicenseFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)LICENSING.md" Pack="true" PackagePath="" />
  </ItemGroup>
</Project>
